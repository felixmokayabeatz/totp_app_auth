# Rendered by deploy/deploy.sh into /etc/systemd/system/__SERVICE_NAME__.service
# Shared by both projects in this repo; __WSGI_APP__ and __PROJECT_DIR__ are
# what make one rendering the downloads site and the other the API.
[Unit]
Description=__DESCRIPTION__
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
User=__RUN_USER__
Group=__RUN_GROUP__
WorkingDirectory=__PROJECT_DIR__
ExecStart=__PROJECT_DIR__/__VENV_DIR__/bin/gunicorn __WSGI_APP__ \
    --bind 127.0.0.1:__GUNICORN_PORT__ \
    --workers __WORKERS__ \
    --timeout 120 \
    --graceful-timeout 30 \
    --access-logfile - \
    --error-logfile -
ExecReload=/bin/kill -s HUP $MAINPID
Restart=always
RestartSec=3
KillMode=mixed

# The app reads secrets from __PROJECT_DIR__/.env via python-dotenv.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
