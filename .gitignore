#=========================================================================
# The three projects in this repo, each self-contained:
#   beatzlock_app/   downloads site, apps.example.com
#   otp_backend/     authenticator API, api.example.com
#   otp_auth_app/    Flutter client
#=========================================================================

# Both Django projects keep their own .env of live database and email
# credentials. Neither is ever committed -- each project's deploy/deploy.sh
# reads it from the server's own copy.

# Virtualenvs. beatzlock_app/deploy/deploy.sh builds beatzlock_app/beatzlock_v_env
# and otp_backend/deploy/deploy.sh builds otp_backend/totp_v_env, so the
# server's directory names match the local ones.
.venv/
*_v_env/
beatzlock_v_env/

# collectstatic output and the pg_dump files the deploy scripts write.
staticfiles/
backups/

# Per-week Django log directories.
logs/
.tmp_test_media/
